# ==================================================================================================
# .dockerignore - what is never copied into the docker image
# --------------------------------------------------------------------------------------------------
# Build output, Git history, recorded runs and caches stay out of the Docker build context. Images
# then build fast and never bake old results or local junk into the environment that produces new 
# results.
# ==================================================================================================

.git
build
install
log
data
.venv
**?__pycache__