# ==================================================================================================
# .clang-format - C++ Formatting Rules
# --------------------------------------------------------------------------------------------------
# This is a single formatting file for every C++ packages.
# Why it Needed - One style keeps reviews about logic not the code layout.
# Note: Run `clang-format -i <file>` before committing C++.
# ==================================================================================================

BasedOnStyle: Google
ColumnLimit: 100
IndentWidth: 4
DerivePointerAlignment: false
PointerAlignment: Left