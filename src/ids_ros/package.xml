<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  =============================================================================
   ids_ros - ROS 2 node for the intrusion detection system
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   Wraps ids_core: listens to the trusted PLC reference and the robot's measurements,
   publishes one status per window and a latched alarm, offers a reset service, and
   runs the calibration.
  =============================================================================
-->

<package format="3">
  <name>ids_ros</name>
  <version>1.2.0</version>
  <description>ROS 2 node for the physics-informed intrusion detection system: trusted-reference tap, sim-time processing, status, alarm, reset and calibration.</description>
  <maintainer email="im.pkm29@gmail.com">Piyush Mishra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ids_core</depend>
  <depend>ids_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
