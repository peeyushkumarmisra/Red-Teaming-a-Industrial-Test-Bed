<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  =============================================================================
   ids_evaluation - score the IDS on recorded runs (v1.4)
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
   Exports run bags to arrays, scores every attack (detected, latency, right joint) and
   every false alarm, replays runs offline through ids_replay, runs baseline detectors
   on the same data, and writes figures and a Markdown/CSV report.
   Runs in the robot container (it needs matplotlib, Pinocchio and xacro), after the
   runs; it never talks to the live system.
  =============================================================================
-->

<package format="3">
  <name>ids_evaluation</name>
  <version>1.4.0</version>
  <description>Offline evaluation of the IDS: run export, detection metrics, offline replay through ids_replay, baseline detectors, figures and reports.</description>
  <maintainer email="im.pkm29@gmail.com">Piyush Mishra</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ids_interfaces</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ids_ros</exec_depend>
  <exec_depend>ids_bringup</exec_depend>
  <exec_depend>iiwa_sim</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
