<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ids_security</name>
  <version>1.6.0</version>
  <description>SROS2 for the four-container cell: security policy, keystore generator and checker, and the latency probe that measures the SROS2 overhead.</description>
  <maintainer email="im.pkm29@gmail.com">Piyush Mishra</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-cryptography</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ids_experiments</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>