<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>ids_bringup</name>
  <version>1.6.0</version>
  <description>Robot-service launch files for the simulated iiwa cell: Gazebo, controllers, bridges, payload spawn, scenario-driven experiment runs with rosbag recording, run supervision, the experiment campaign, the cell agents that start the plc and attacker containers' nodes, and the monitor bridge between the cell and monitor DDS domains.</description>
  <maintainer email="im.pkm29@gmail.com">Piyush Mishra</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>ids_interfaces</exec_depend>
  <exec_depend>ids_experiments</exec_depend>
  <exec_depend>iiwa_sim</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>