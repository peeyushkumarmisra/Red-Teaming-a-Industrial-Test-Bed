<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="iiwa_friction_joint" params="name index friction">
    <joint>
      <name>${name}</name>
      <initial>${friction['initial'][index]}</initial>
      <rate>${friction['rate'][index]}</rate>
      <max>${friction['max'][index]}</max>
    </joint>
  </xacro:macro>

  <xacro:macro name="iiwa_gazebo" params="prefix controllers_file friction">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
        <hold_joints>true</hold_joints>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>${prefix}link_7</parent_link>
        <child_model>payload</child_model>
        <child_link>cube_link</child_link>
        <attach_topic>/gripper/attach</attach_topic>
        <detach_topic>/gripper/detach</detach_topic>
        <output_topic>/gripper/state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="iiwa_friction_drift" name="iiwa_sim::FrictionDrift">
        <delay>${friction['delay']}</delay>
        <truth_topic>/sim/friction_truth</truth_topic>
        <truth_rate>100</truth_rate>
        <xacro:iiwa_friction_joint name="${prefix}joint_a1" index="0" friction="${friction}"/>
        <xacro:iiwa_friction_joint name="${prefix}joint_a2" index="1" friction="${friction}"/>
        <xacro:iiwa_friction_joint name="${prefix}joint_a3" index="2" friction="${friction}"/>
        <xacro:iiwa_friction_joint name="${prefix}joint_a4" index="3" friction="${friction}"/>
        <xacro:iiwa_friction_joint name="${prefix}joint_a5" index="4" friction="${friction}"/>
        <xacro:iiwa_friction_joint name="${prefix}joint_a6" index="5" friction="${friction}"/>
        <xacro:iiwa_friction_joint name="${prefix}joint_a7" index="6" friction="${friction}"/>
      </plugin>
    </gazebo>

    <gazebo reference="${prefix}link_7">
      <material>Gazebo/Gray</material>
    </gazebo>
  </xacro:macro>

</robot>